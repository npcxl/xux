{
  "name": "@xux/monorepo",
  "version": "1.0.1",
  "private": true,
  "description": "VUE3组件库 Monorepo",
  "scripts": {
    "dev": "pnpm --filter @xux/docs dev",
    "dev:react": "pnpm --filter @xux/docs-react dev",
    "dev:demo": "pnpm --filter @xux/demo dev",
    "build": "pnpm --filter @xlui/xux-ui build && pnpm --filter @xlui/xux-react build && pnpm --filter @xux/docs build && pnpm --filter @xux/docs-react build",
    "build:vue": "pnpm --filter @xlui/xux-ui build",
    "build:react": "pnpm --filter @xlui/xux-react build",
    "build:ui": "pnpm build:vue && pnpm build:react",
    "build:docs": "pnpm --filter @xux/docs build",
    "build:docs-react": "pnpm --filter @xux/docs-react build",
    "build:demo": "pnpm --filter @xux/demo build",
    "preview": "pnpm --filter @xux/docs preview",
    "preview:react": "pnpm --filter @xux/docs-react preview",
    "publish:vue": "cd packages/vue && pnpm publish",
    "publish:react": "cd packages/react && pnpm publish",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "dayjs": "^1.11.18",
    "qrcode": "^1.5.4",
    "sass": "^1.93.2"
  }
}
