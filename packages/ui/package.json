{
  "name": "@xlui/xux-ui",
  "version": "1.3.14",
  "description": "VUE3组件库",
  "author": "leheya",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": {
      "default": "./dist/index.css"
    },
    "./style.css": {
      "default": "./dist/index.css"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js",
      "default": "./dist/*"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "vue3",
    "vue3-ui",
    "components",
    "ui-library",
    "ecommerce",
    "电商组件",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/leheya/xux"
  },
  "homepage": "https://gitee.com/leheya/xux",
  "bugs": {
    "url": "https://gitee.com/leheya/xux/issues"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.5",
    "@iconify/vue": "^4.1.1",
    "axios": "^1.12.2",
    "dayjs": "^1.11.10",
    "element-china-area-data": "^6.1.0",
    "element-plus": "^2.9.3",
    "glob": "^11.0.3",
    "pinyin": "^4.0.0",
    "qrcode": "^1.5.4",
    "xe-utils": "^3.7.9"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.4.15",
    "vue-tsc": "^1.8.27"
  }
}
