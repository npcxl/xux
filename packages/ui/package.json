{
  "name": "@xlui/xux-ui",
  "version": "0.2.0",
  "description": "VUE3 电商组件库",
  "author": "leheya",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./style.css": "./dist/index.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "vue3",
    "vue3-ui",
    "components",
    "ui-library",
    "ecommerce",
    "电商组件",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/leheya/xux"
  },
  "homepage": "https://gitee.com/leheya/xux",
  "bugs": {
    "url": "https://gitee.com/leheya/xux/issues"
  },
  "dependencies": {
    "dayjs": "^1.11.10"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vue": "^3.4.15",
    "vue-tsc": "^1.8.27"
  }
}

